# tl-agent — environment configuration template
#
# Copy this file to `.env` and fill in the values you need. The actual
# `.env` is gitignored. Pydantic-settings reads it at startup; bash seed
# scripts source it before running.
#
# All variables share the TLA_ prefix to keep the global namespace tidy.
#
# ─────────────────────────────────────────────────────────────────────────
# CONFIGURATION MATRIX — mix mock and real services freely
# ─────────────────────────────────────────────────────────────────────────
# Each integration (chat / Jira / GitLab) is independent. To use a real
# service instead of the bundled mock:
#   1. UNCOMMENT and set that service's *_BASE_URL / *_URL + token below.
#   2. Drop its compose profile so the mock doesn't boot.
# Leave the URL commented → the agent container talks to the bundled mock
# (compose supplies the sibling-container DNS name automatically).
#
#   Want…                          | profiles to run        | set in .env
#   -------------------------------+------------------------+----------------------
#   everything bundled (demo)      | mattermost,jira,gitlab | nothing (defaults)
#   mock MM + real Jira + GitLab   | mattermost             | TLA_JIRA_BASE_URL+TOKEN,
#                                  |                        | TLA_GITLAB_BASE_URL+TOKEN
#   real Slack + real Jira+GitLab  | (none)                 | TLA_CHAT_PROVIDER=slack,
#                                  |                        | TLA_SLACK_*, TLA_JIRA_*,
#                                  |                        | TLA_GITLAB_*
# Run the agent itself with the `agent` profile in every case. The Makefile
# wraps these: `make up-bundled`, `make up-mock-chat`, `make up-real`.
# ─────────────────────────────────────────────────────────────────────────

# -------------------- LLM provider --------------------
# Anthropic API key (required for any LLM-driven phase).
TLA_ANTHROPIC_API_KEY=

# Ollama base URL (optional; only used when router routes to ollama).
# Leave commented: host runs default to localhost:11434, the agent container
# defaults to the `ollama` service. Uncomment only to point elsewhere.
# TLA_OLLAMA_BASE_URL=http://localhost:11434/v1

# Default Ollama model tag (used when a router route picks provider=ollama
# but omits an explicit model). `ollama pull qwen3:8b` before first use.
TLA_OLLAMA_MODEL=qwen3:8b

# Per-request HTTP timeout for Ollama. Cold loads of an 8B model can take
# tens of seconds; Phase 5 ReACT calls can run longer. Bump if you see
# `phase*.failed err_type=ReadTimeout`.
TLA_OLLAMA_TIMEOUT_SECONDS=300

# Default provider for the model router (must match config/router.yaml routes).
TLA_DEFAULT_PROVIDER=anthropic

# Path to the router YAML. Empty → config/router.yaml (Anthropic-everywhere).
# Set to config/router.ollama.yaml to run the whole pipeline on a local model.
TLA_ROUTER_CONFIG=

# -------------------- observability --------------------
# Phoenix OTLP/HTTP endpoint (set to empty to disable remote tracing).
# Leave commented: host runs default to localhost:6006, the agent container
# defaults to the `phoenix` service. Set empty (TLA_OTLP_ENDPOINT=) to disable.
# TLA_OTLP_ENDPOINT=http://localhost:6006/v1/traces

# Per-batch OTLP export timeout (seconds). 2s is too tight when the host
# is busy serving a local model; raise if you see `Failed to export span
# batch ... Read timed out`.
TLA_OTLP_TIMEOUT_SECONDS=10

# Whether to mirror spans to traces/YYYY-MM-DD/spans.jsonl on disk.
TLA_ENABLE_JSONL_SINK=true

# Emit full LLM request/response payloads as span attributes (request messages,
# system prompt, response text, tool_uses). Phoenix renders these as a
# Conversation tab. Off by default — payloads can contain ticket bodies and
# names. Set to 1 / true when debugging prompt behaviour.
TLA_LOG_LLM_PAYLOADS=false

# -------------------- chat provider --------------------
# Which adapter to use (mattermost | slack).
TLA_CHAT_PROVIDER=mattermost

# Mattermost runtime token (bot personal access token from the seed step).
# Leave URL commented to use the bundled container; uncomment + set to point
# at a self-hosted/real Mattermost.
# TLA_MATTERMOST_URL=http://localhost:8065
TLA_MATTERMOST_TOKEN=
TLA_MATTERMOST_TEAM=engineering
TLA_MATTERMOST_WEBHOOK_SECRET=dev-shared-secret-change-me

# Mattermost seed-time admin (only used by services/mattermost_seed/seed.py
# on first boot). Override if you already created a different admin manually.
TLA_MATTERMOST_ADMIN_USER=tl-admin
TLA_MATTERMOST_ADMIN_EMAIL=tl-admin@example.local
TLA_MATTERMOST_ADMIN_PW=Tl-AdminPw1!

# Slack — only needed if you flip TLA_CHAT_PROVIDER=slack.
TLA_SLACK_BOT_TOKEN=
TLA_SLACK_SIGNING_SECRET=

# -------------------- Jira (mock by default) --------------------
# Leave URL commented → bundled jira_mock (run the `jira` profile).
# To use real Atlassian Cloud: uncomment, set the URL, drop the `jira`
# profile, and set TLA_JIRA_TOKEN to base64("email:api_token") — create the
# token at https://id.atlassian.com/manage-profile/security/api-tokens
# TLA_JIRA_BASE_URL=http://localhost:9100
TLA_JIRA_TOKEN=dev-token

# -------------------- GitLab --------------------
# Leave URL commented → bundled GitLab CE (run the `gitlab` profile).
# To use gitlab.com or self-hosted: uncomment, set the URL (e.g.
# https://gitlab.com), drop the `gitlab` profile, and set TLA_GITLAB_TOKEN to
# a Personal Access Token with the `read_api` scope.
# TLA_GITLAB_BASE_URL=http://localhost:8929
# Runtime token used by tools/gitlab.py (Personal Access Token, `read_api`).
TLA_GITLAB_TOKEN=
# Seed-time admin token used by infra/gitlab/seed.sh (PAT with `api` scope).
# If empty, the seed script falls back to TLA_GITLAB_TOKEN.
TLA_GITLAB_ADMIN_TOKEN=

# -------------------- budgets --------------------
TLA_REACT_MAX_STEPS=12
TLA_REACT_WALL_CLOCK_SECONDS=60
TLA_REACT_TOKEN_BUDGET=30000
TLA_RUN_TOKEN_BUDGET=500000

# -------------------- apple-silicon compose override --------------------

# Uncomment on arm64 hosts to use the community GitLab CE arm64 build
# instead of running the official amd64 image under Rosetta.
# TLA_GITLAB_IMAGE=yrzr/gitlab-ce-arm64v8:17.5.0-ce.0
