# Container-network defaults for the tl-agent app (see docker-compose.yml).
#
# Loaded BEFORE ../.env, so anything you set (uncomment) in ../.env overrides
# these. That is the mock-vs-real switch: leave a URL unset in .env → the
# agent talks to the bundled sibling container named here; set it in .env →
# the agent talks to your real endpoint instead.
#
# These names are Docker Compose service DNS names, resolvable only from
# inside the compose network — never use them for host-side runs.
TLA_MATTERMOST_URL=http://mattermost:8065
TLA_JIRA_BASE_URL=http://jira_mock:9100
# "3" = Cloud (ADF bodies), "2" = Server/Data Center (plain text).
TLA_JIRA_API_VERSION=3
TLA_GITLAB_BASE_URL=http://gitlab:8929
TLA_OTLP_ENDPOINT=http://phoenix:6006/v1/traces
TLA_OLLAMA_BASE_URL=http://ollama:11434/v1
